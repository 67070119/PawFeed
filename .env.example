# Application
NODE_ENV=production
TZ=Asia/Bangkok

# Frontend / Backend Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Authentication
JWT_ACCESS_SECRET=GENERATE_WITH_SETUP
JWT_ACCESS_EXPIRES_IN=15m
COOKIE_SECURE=false

# PostgreSQL
POSTGRES_DB=pawfeed
POSTGRES_USER=pawfeed
POSTGRES_PASSWORD=GENERATE_WITH_SETUP

# Upload
MAX_UPLOAD_SIZE_MB=5

# Routing
ROUTING_BASE_URL=https://routing.openstreetmap.de
ROUTING_TIMEOUT_MS=8000
ROUTING_RETRIES=1

# Local email inbox: http://localhost:8025 (no real emails leave the machine)
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH_REQUIRED=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PawFeed <no-reply@pawfeed.local>"

# For LAN / HTTPS demo, set the actual browser URL here (used in email links).
# PUBLIC_FRONTEND_URL=https://pawfeed.example.com
