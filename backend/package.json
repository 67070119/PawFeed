{
  "name": "pawfeed-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand",
    "lint": "eslint \"src/**/*.js\"",
    "build": "prisma generate && node --check src/server.js",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "jest": "30.1.3",
    "prisma": "6.12.0",
    "supertest": "7.1.4"
  }
}
